# Copy this file to .env and adjust values as needed.
# Frame size in WIDTH HEIGHT, WIDTHxHEIGHT, or WIDTH,HEIGHT format
SHARINGAN_FRAME_SIZE=240x240
# Emit RGB565 binary payloads (set to false to export PNGs instead)
SHARINGAN_RGB565=true
# Byte order for RGB565 payloads: little or big
SHARINGAN_BYTEORDER=little
# Enable Floyd-Steinberg dithering during conversion
SHARINGAN_DITHER=false
# Produce PNG previews alongside RGB565 output
SHARINGAN_PREVIEW=false
